{
    "name": "frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build && node scripts/copy-404.mjs",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:scss": "stylelint \"src/**/*.scss\"",
        "lint:scss:fix": "stylelint \"src/**/*.scss\" --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,scss}\" \"*.{js,cjs,mjs,ts,json,md}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\" \"*.{js,cjs,mjs,ts,json,md}\"",
        "verify": "npm run format:check && npm run lint && npm run lint:scss && npm run build",
        "preview": "vite preview"
    },
    "dependencies": {
        "@reduxjs/toolkit": "^2.14.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-icons": "^5.7.0",
        "react-redux": "^9.3.1",
        "react-router-dom": "^7.18.5",
        "react-slick": "^0.31.0",
        "sass": "^1.108.2",
        "slick-carousel": "^2.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-slick": "^0.23.13",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^9.39.5",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.14.0",
        "prettier": "^3.10.1",
        "stylelint": "^18.0.0",
        "stylelint-config-standard-scss": "^18.0.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.2",
        "vite": "^8.3.6"
    }
}
